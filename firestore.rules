rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /store_simulations/{doc} {
      allow read, write: if request.auth != null;
    }
    match /store_sim_users/{doc} {
      allow read, write: if request.auth != null;
    }
    match /store_drawings/{doc} {
      allow read, write: if request.auth != null;
    }
    match /ss_vendor_contacts/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
