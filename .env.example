# store_simulator/seed.mjs 用の環境変数
# このファイルをコピーして .env を作成し、実際の値を設定してください
# .env は .gitignore に含まれており、Git にはコミットされません

# Google OAuth クライアントID（Google Cloud Console で取得）
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google OAuth クライアントシークレット（Google Cloud Console で取得）
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth リフレッシュトークン（初回認証後に取得）
GOOGLE_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
